{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "settings": {
        "skipAudits": [
          "is-crawlable"
        ]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.7
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 4000
          }
        ],
        "total-blocking-time": [
          "error",
          {
            "maxNumericValue": 600
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.25
          }
        ],
        "first-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 3000
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".ss/reports/cwv/lighthouse"
    }
  }
}
